#!/usr/bin/env bash
# selftest-infra - failure-path tests for the TreeAI D1 acceptance gate (Agent D owned).
#
# The happy path (everything PASS / NOT_RUN) is covered by scripts/verify-d1
# itself. This script proves the gate actually FAILS when it must, using
# throwaway copies of d1-spikes in a system temp dir:
#
#   T1 tampered fixture            -> fixtures-integrity FAIL, exit 2
#   T2 untraceable PASS claim      -> scenario row FAIL, exit 2
#   T3 leaking evidence file       -> redaction-evidence FAIL, exit 2
#   T4 valid PASS with real events -> scenario row PASS, overall exit 3
#   T5 events with broken seq      -> scenario row FAIL, exit 2
#   T6 BLOCKED claiming exit 0     -> exit-codes row FAIL, exit 2
#                                     (gap fix 2026-09-20: BLOCKED/NOT_RUN
#                                      must exit non-zero; schema revision
#                                      2026-09-20 makes the result file
#                                      itself invalid as well)
#   T7 leak in verify's own output -> post-write self-scan forces exit 2 and
#                                     the summary JSON is RESYNCHRONIZED
#                                     (gap fix 2026-09-20: overall.exitCode/
#                                      verdict/counts must match the real
#                                     exit code). The leak rides in an
#                                     incomplete run DIRECTORY name, which
#                                     the pre-write file scans cannot see
#                                     (directories are not file content),
#                                     so only the post-write scan of the
#                                     freshly written summary/log catches it.
#
# Nothing in the real d1-spikes tree is modified. A machine-readable result
# is appended to d1-spikes/evidence/verification/selftest-infra-<ts>.json.
#
# Exit codes: 0 = all tests behaved as expected, 1 = at least one did not.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
D1_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
EVID_VER="$D1_ROOT/evidence/verification"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/treeai-d1-selftest-infra.XXXXXXXX")"

cleanup() { rm -rf "$TMP" 2>/dev/null || true; return 0; }
trap cleanup EXIT

PY=python3

# Test-isolation note: at 2026-09-18T11:59Z the workspace secret scan flagged
# 13 findings in sdk-node/tests/recorder.test.ts and redact.test.ts (Agent B's
# synthetic redactor corpus with contiguous secret-looking strings). Agent B
# fixed those files at ~12:10Z by assembling the synthetic tokens at runtime,
# and the workspace has scanned clean since 12:20Z. The copies below still
# remove these two files defensively so that a future regression in them (or
# any other delivered test corpus) cannot silently shift these failure-path
# expectations; the real workspace scan always reports the real state.
KNOWN_SCAN_NOISE=(
  "sdk-node/tests/recorder.test.ts"
  "sdk-node/tests/redact.test.ts"
)

# Test-isolation note (2026-09-20): Agent B is concurrently developing the
# tree-nav scenario in the shared workspace during this closing phase; its
# in-progress unit tests (tests/tree-nav.test.ts and the tree-nav assertions
# in tests/static.test.ts) can make `npm test` fail for reasons unrelated to
# what T4 and T7 exercise. Later the same day Agent C's in-progress
# tree-nav tests (rpc-python tests/test_tree_nav.py) showed the same
# pattern on the RPC side. The pass/fail state of B/C work-in-progress
# tests is NOT the object under test here - the real workspace verify runs
# record the real state, whatever it is. For the two cases that assert a
# precise overall exit code with no other FAIL present (T4 expects 3; T7
# needs a clean 3 so the post-write override 3->2 is observable), the
# THROWAWAY COPY replaces both unit-test entry points with deterministic
# passes: the npm test script becomes a no-op and rpc-python tests/ becomes
# a single trivial stub test. The real tree is never touched.
isolate_in_progress_unit_tests() {
  "$PY" - "$TMP/case" <<'PYEOF'
import json
import os
import sys
case = sys.argv[1]
p = case + "/sdk-node/package.json"
with open(p) as fh:
    d = json.load(fh)
d["scripts"]["test"] = "node -e 0"
with open(p, "w") as fh:
    json.dump(d, fh, indent=2)
    fh.write("\n")
tdir = case + "/rpc-python/tests"
if os.path.isdir(tdir):
    import shutil
    shutil.rmtree(tdir)
os.makedirs(tdir, exist_ok=True)
with open(os.path.join(tdir, "test__isolation_stub.py"), "w") as fh:
    fh.write("import unittest\n\n\n"
             "class IsolationStub(unittest.TestCase):\n"
             "    def test_stub(self):\n"
             "        self.assertTrue(True)\n")
PYEOF
}

fresh_copy() {
  rm -rf "$TMP/case"
  # -c uses APFS clonefile (fast copy-on-write); fall back to a plain copy
  cp -Rc "$D1_ROOT" "$TMP/case" 2>/dev/null || cp -R "$D1_ROOT" "$TMP/case"
  # evidence written by earlier real runs must not influence the test cases
  rm -rf "$TMP/case/evidence/verification"
  mkdir -p "$TMP/case/evidence/verification"
  for noise in "${KNOWN_SCAN_NOISE[@]}"; do
    rm -f "$TMP/case/$noise"
  done
}

run_case_verify() {
  ( cd "$TMP/case" && rc=0; ./scripts/verify-d1 > verify-out.txt 2>&1 || rc=$?; echo "$rc" > verify-exit.txt )
}

row_status() {
  ( cd "$TMP/case" && grep -E "^\[[ 0-9/]+\] +[A-Z_]+ +$1( |$)" verify-out.txt | head -1 | sed -E 's/^\[[ 0-9/]+\] +([A-Z_]+) +.*/\1/' )
}

overall_exit() {
  ( cd "$TMP/case" && cat verify-exit.txt )
}

pass=0
fail=0
declare -a RESULTS

record() { # name expected actual
  if [ "$2" = "$3" ]; then
    RESULTS+=("{\"name\": \"$1\", \"expected\": \"$2\", \"actual\": \"$3\", \"ok\": true}")
    pass=$((pass + 1))
    printf '  %-28s ok (expected %s)\n' "$1" "$2"
  else
    RESULTS+=("{\"name\": \"$1\", \"expected\": \"$2\", \"actual\": \"$3\", \"ok\": false}")
    fail=$((fail + 1))
    printf '  %-28s MISMATCH (expected %s, got %s)\n' "$1" "$2" "$3"
    if [ -f "$TMP/case/verify-out.txt" ]; then
      echo "    ---- FAIL rows in this case's verify output ----"
      grep -A4 "FAIL" "$TMP/case/verify-out.txt" | sed 's/^/    /' || true
      echo "    ------------------------------------------------"
    fi
  fi
}

echo "selftest-infra: failure-path tests for the D1 acceptance gate"

echo "T1: tampered fixture"
fresh_copy
"$PY" -c "
import json
p = '$TMP/case/fixtures/numbers.json'
d = json.load(open(p))
d['values'][0] = 99
json.dump(d, open(p, 'w'), indent=2)
"
run_case_verify
record "T1 fixtures-integrity row" "FAIL" "$(row_status fixtures-integrity)"
record "T1 overall exit" "2" "$(overall_exit)"

echo "T2: untraceable PASS claim"
fresh_copy
mkdir -p "$TMP/case/evidence/sdk"
"$PY" -c "
import json
r = {'implementation': 'sdk-node', 'scenario': 'basic', 'status': 'PASS',
     'startedAt': '2026-09-18T01:00:00.000Z', 'endedAt': '2026-09-18T01:00:05.000Z',
     'durationMs': 5000, 'command': 'node dist/basic.js', 'exitCode': 0,
     'evidenceFiles': ['evidence/sdk/basic.events.jsonl'],
     'observations': ['claim'], 'limitations': [], 'error': None}
json.dump(r, open('$TMP/case/evidence/sdk/basic.result.json', 'w'), indent=2)
"
run_case_verify
record "T2 scenario row" "FAIL" "$(row_status scenario-sdk-node-basic)"
record "T2 overall exit" "2" "$(overall_exit)"

echo "T3: leaking evidence file"
fresh_copy
mkdir -p "$TMP/case/evidence/sdk"
# Leak strings are assembled at runtime from pieces so that this script's own
# source never contains a contiguous secret-like pattern (the real workspace
# scan would otherwise correctly flag it).
"$PY" - "$TMP/case" <<'PYEOF'
import sys
case = sys.argv[1]
leak1 = "{" + '"Authorization"' + ": " + '"Bearer ' + "abcdef1234567890abcd" + '"}'
leak2 = "{" + '"path"' + ": " + '"/Users/' + "leakyuser" + '/project/out.json"}'
with open(case + "/evidence/sdk/leaky.json", "w") as fh:
    fh.write(leak1 + "\n" + leak2 + "\n")
PYEOF
run_case_verify
record "T3 redaction-evidence row" "FAIL" "$(row_status redaction-evidence)"
record "T3 overall exit" "2" "$(overall_exit)"

echo "T4: valid traceable PASS"
fresh_copy
isolate_in_progress_unit_tests   # keep B/C in-progress tree-nav tests out of T4's exit-3 expectation
mkdir -p "$TMP/case/evidence/sdk"
"$PY" - "$TMP/case" <<'PYEOF'
import json
import sys
case = sys.argv[1]
events = []
for i, (t, et, rs) in enumerate([
        ("00:00:00.000Z", "message_start", "running"),
        ("00:00:01.000Z", "message_update", "running"),
        ("00:00:02.000Z", "message_end", "completed")], start=1):
    events.append({"seq": i, "observedAt": "2026-09-18T" + t,
                   "implementation": "sdk-node", "scenario": "basic",
                   "sessionId": "test-session-001", "piEventType": et,
                   "runState": rs, "payload": {}, "redactionVersion": "d1-v1"})
with open(case + "/evidence/sdk/basic.events.jsonl", "w") as fh:
    for e in events:
        fh.write(json.dumps(e) + "\n")
r = {"implementation": "sdk-node", "scenario": "basic", "status": "PASS",
     "startedAt": "2026-09-18T00:00:00.000Z", "endedAt": "2026-09-18T00:00:02.000Z",
     "durationMs": 2000, "command": "node dist/basic.js", "exitCode": 0,
     "evidenceFiles": ["evidence/sdk/basic.events.jsonl"],
     "observations": ["three events observed in order"],
     "limitations": [], "error": None}
json.dump(r, open(case + "/evidence/sdk/basic.result.json", "w"), indent=2)
PYEOF
run_case_verify
record "T4 scenario row" "PASS" "$(row_status scenario-sdk-node-basic)"
record "T4 overall exit" "3" "$(overall_exit)"

echo "T5: events with broken seq order"
fresh_copy
mkdir -p "$TMP/case/evidence/sdk"
"$PY" - "$TMP/case" <<'PYEOF'
import json
import sys
case = sys.argv[1]
events = []
for i, seq in enumerate([1, 3, 2], start=1):
    events.append({"seq": seq, "observedAt": "2026-09-18T00:00:0%d.000Z" % i,
                   "implementation": "sdk-node", "scenario": "basic",
                   "sessionId": "test-session-001", "piEventType": "message_update",
                   "runState": "running", "payload": {}, "redactionVersion": "d1-v1"})
with open(case + "/evidence/sdk/basic.events.jsonl", "w") as fh:
    for e in events:
        fh.write(json.dumps(e) + "\n")
r = {"implementation": "sdk-node", "scenario": "basic", "status": "PASS",
     "startedAt": "2026-09-18T00:00:00.000Z", "endedAt": "2026-09-18T00:00:02.000Z",
     "durationMs": 2000, "command": "node dist/basic.js", "exitCode": 0,
     "evidenceFiles": ["evidence/sdk/basic.events.jsonl"],
     "observations": ["claim"], "limitations": [], "error": None}
json.dump(r, open(case + "/evidence/sdk/basic.result.json", "w"), indent=2)
PYEOF
run_case_verify
record "T5 scenario row" "FAIL" "$(row_status scenario-sdk-node-basic)"
record "T5 overall exit" "2" "$(overall_exit)"

echo "T6: BLOCKED result claiming exit 0 (exit-code reservation gap)"
fresh_copy
mkdir -p "$TMP/case/evidence/sdk"
"$PY" - "$TMP/case" <<'PYEOF'
import json
import sys
case = sys.argv[1]
# schema-valid BLOCKED shape but with a lying exitCode=0: under the
# 2026-09-20 schema revision the file itself is schema-invalid, and
# check_exit_codes must flag the BLOCKED/exit-0 combination even though
# the scenario row already FAILed on schema grounds (the result summary
# still enters the exit-code cache before the schema early-return).
events = []
for i, (t, et, rs) in enumerate([
        ("00:00:00.000Z", "message_start", "running"),
        ("00:00:01.000Z", "message_update", "running"),
        ("00:00:02.000Z", "message_end", "completed")], start=1):
    events.append({"seq": i, "observedAt": "2026-09-18T" + t,
                   "implementation": "sdk-node", "scenario": "basic",
                   "sessionId": "test-session-001", "piEventType": et,
                   "runState": rs, "payload": {}, "redactionVersion": "d1-v1"})
with open(case + "/evidence/sdk/basic.events.jsonl", "w") as fh:
    for e in events:
        fh.write(json.dumps(e) + "\n")
r = {"implementation": "sdk-node", "scenario": "basic", "status": "BLOCKED",
     "blockedReason": "CREDENTIALS",
     "startedAt": "2026-09-18T00:00:00.000Z", "endedAt": "2026-09-18T00:00:02.000Z",
     "durationMs": 2000, "command": "node dist/basic.js", "exitCode": 0,
     "evidenceFiles": ["evidence/sdk/basic.events.jsonl"],
     "observations": ["blocked attempt"], "limitations": [],
     "error": {"message": "no model credentials", "code": "Eauth"}}
json.dump(r, open(case + "/evidence/sdk/basic.result.json", "w"), indent=2)
PYEOF
run_case_verify
record "T6 exit-codes row" "FAIL" "$(row_status exit-codes)"
record "T6 overall exit" "2" "$(overall_exit)"

echo "T7: post-write leak in verify's own output (summary sync gap)"
fresh_copy
isolate_in_progress_unit_tests   # T7 needs a clean pre-override verdict of 3 so the post-write 3->2 override is observable
# The leak rides in an incomplete run DIRECTORY name. Directory names are
# invisible to the pre-write scans (they scan file contents and file
# basenames only), but the name flows into the run-selection notes of the
# PASS scenario rows and into the summary JSON evidenceLayout - so only the
# post-write self-scan of the freshly written summary/log can catch it.
# Assembled at runtime from pieces so this script's own source stays clean.
LEAKY_RUN="zz-sk-""ant-""abcdef0123456789abcdef"
mkdir -p "$TMP/case/evidence/sdk/runs/$LEAKY_RUN"
run_case_verify
record "T7 overall exit (post-write override)" "2" "$(overall_exit)"
T7_SYNC="$("$PY" - "$TMP/case" <<'PYEOF'
import glob
import json
import sys
case = sys.argv[1]
files = sorted(glob.glob(case + "/evidence/verification/verify-*.json"))
if not files:
    print("no-summary")
    raise SystemExit
d = json.load(open(files[-1]))
ov = d.get("overall", {})
lines = []
lines.append(str(ov.get("exitCode")))
lines.append(str(ov.get("verdict")))
pw = d.get("postWriteScan", {})
lines.append("present" if pw.get("findingCount") else "missing")
row = [c for c in d.get("checks", []) if c.get("id") == "post-write-selfscan"]
lines.append("present" if row else "missing")
fail_count = d.get("counts", {}).get("FAIL", 0)
lines.append("ok" if fail_count >= 1 else "fail=%s" % fail_count)
new_leaks = d.get("postWriteScan", {}).get("newFindingsFromRewrite")
lines.append("clean" if new_leaks == 0 else "new=%s" % new_leaks)
log = open(files[-1].replace(".json", ".log")).read()
lines.append("notified" if "POST-WRITE LEAK DETECTED" in log else "log-missing-notice")
print("\n".join(lines))
PYEOF
)"
T7_EXIT_SYNC="$(printf '%s\n' "$T7_SYNC" | sed -n 1p)"
T7_VERDICT_SYNC="$(printf '%s\n' "$T7_SYNC" | sed -n 2p)"
T7_POSTSCAN="$(printf '%s\n' "$T7_SYNC" | sed -n 3p)"
T7_ROWPRESENT="$(printf '%s\n' "$T7_SYNC" | sed -n 4p)"
T7_FAILCOUNT="$(printf '%s\n' "$T7_SYNC" | sed -n 5p)"
T7_NEWLEAKS="$(printf '%s\n' "$T7_SYNC" | sed -n 6p)"
T7_LOGNOTICE="$(printf '%s\n' "$T7_SYNC" | sed -n 7p)"
record "T7 summary overall.exitCode synced" "2" "$T7_EXIT_SYNC"
record "T7 summary overall.verdict synced" "HAS_FAIL" "$T7_VERDICT_SYNC"
record "T7 postWriteScan section" "present" "$T7_POSTSCAN"
record "T7 post-write FAIL row in checks" "present" "$T7_ROWPRESENT"
record "T7 counts.FAIL >= 1" "ok" "$T7_FAILCOUNT"
record "T7 resync introduced no new leak" "clean" "$T7_NEWLEAKS"
record "T7 log rewritten with notice" "notified" "$T7_LOGNOTICE"

mkdir -p "$EVID_VER"
TS="$(date -u +%Y%m%dT%H%M%S)Z"
RESULT_FILE="$EVID_VER/selftest-infra-$TS.json"
{
  printf '{\n  "selftest": "selftest-infra",\n  "version": "d1-v1",\n'
  printf '  "startedAt": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "passed": %d,\n  "failed": %d,\n  "results": [\n' "$pass" "$fail"
  for i in "${RESULTS[@]}"; do
    printf '    %s' "$i"
    if [ "$i" != "${RESULTS[${#RESULTS[@]}-1]}" ]; then printf ','; fi
    printf '\n'
  done
  printf '  ]\n}\n'
} > "$RESULT_FILE"

echo ""
if [ "$fail" = "0" ]; then
  echo "SELFTEST: PASS ($pass assertions; details: evidence/verification/$(basename "$RESULT_FILE"))"
  exit 0
else
  echo "SELFTEST: FAIL ($fail of $((pass + fail)) assertions mismatched; details: evidence/verification/$(basename "$RESULT_FILE"))"
  exit 1
fi
