#!/usr/bin/env python3
"""check-secrets - secret and redaction scanner for TreeAI D1 (Agent D owned).

Scans text files under d1-spikes (or given paths) for:
  - common API key forms (Anthropic, OpenAI, AWS, Google, GitHub, Slack)
  - Authorization/Bearer headers, standalone bearer tokens, JWTs
  - secret-like env var assignments (KEY=value) and JSON/YAML secret fields
  - .npmrc _authToken lines, netrc-style credential lines, PEM private keys
  - absolute user-home paths (redaction requirement for D1 evidence)
  - presence of credential files (.env, .netrc, .git-credentials, id_rsa,
    *.pem, *.key, service-account*.json, *credentials*.json, .htpasswd,
    bare "credentials")

Findings are reported with masked excerpts only (first 4 characters); the
full match is never written to the report. Paths in the report are relative
to the d1-spikes root. Skipped directories: .git, node_modules, venvs,
caches, dist, build (documented blind spots - third-party vendored code is
not scanned).

Usage:
  check-secrets [PATH ...]              # default path: d1-spikes root
  check-secrets --json OUT [PATH ...]   # machine-readable JSON to OUT
  check-secrets --selftest              # synthetic-corpus self-test

Exit codes: 0 = no findings, 1 = findings, 2 = usage or tool error.
The self-test builds its synthetic corpus in a system temp dir at runtime
and removes it afterwards, so no fake tokens are ever stored in the repo.
"""

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
from datetime import datetime, timezone

SCANNER_VERSION = "d1-v1"

SCRIPT_PATH = os.path.abspath(__file__)
D1_ROOT = os.path.dirname(os.path.dirname(SCRIPT_PATH))

SKIP_DIRS = {
    ".git", "node_modules", ".venv", "venv", "__pycache__",
    ".pytest_cache", ".mypy_cache", ".ruff_cache", "dist", "build",
}
SKIP_FILES = {".DS_Store"}
MAX_FILE_BYTES = 20 * 1024 * 1024
BINARY_SNIFF_BYTES = 8192

RULES = [
    # (rule_id, compiled regex, description)
    ("anthropic-key",
     re.compile(r"sk-ant-[A-Za-z0-9_\-]{16,}"),
     "Anthropic-style API key"),
    ("openai-key",
     re.compile(r"sk-(?!ant-)[A-Za-z0-9_\-]{32,}"),
     "OpenAI-style API key"),
    ("aws-access-key",
     re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"),
     "AWS access key id"),
    ("google-api-key",
     re.compile(r"\bAIza[0-9A-Za-z_\-]{35}"),
     "Google API key"),
    ("github-token",
     re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}"),
     "GitHub token"),
    ("slack-token",
     re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}"),
     "Slack token"),
    ("private-key-block",
     re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----"),
     "PEM private key block"),
    ("jwt",
     re.compile(r"\beyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{4,}"),
     "JSON Web Token"),
    ("bearer-header",
     re.compile(r"(?i)\bauthorization\b['\"]?\s*[:=]\s*['\"]?\s*bearer\s+[A-Za-z0-9\-._~+/]{8,}"),
     "Auth header carrying a bearer value"),
    ("bearer-standalone",
     re.compile(r"(?i)\bbearer\s+[A-Za-z0-9\-._~+/]{20,}"),
     "Standalone bearer token"),
    ("env-secret-assignment",
     re.compile(r"(?im)^[ \t]*(?:export[ \t]+)?[A-Za-z_][A-Za-z0-9_]*"
                r"(?:API_KEY|SECRET|TOKEN|PASSWORD|PASSWD|CREDENTIAL)[A-Za-z0-9_]*"
                r"[ \t]*=[ \t]*[\"']?"
                r"(?=[^\r\n]*[A-Za-z])(?=[^\r\n]*[0-9])[^\s\"']{8,}"),
     "Secret-like env var assignment"),
    ("json-secret-field",
     re.compile(r"(?i)[\"']?[A-Za-z0-9_\-]*(?:api_key|apikey|secret|token|password|passwd|credential)"
                r"[A-Za-z0-9_\-]*[\"']?[ \t]*:[ \t]*[\"'](?=[^\"']*[0-9])[^\"']{12,}[\"']"),
     "Secret-like JSON or YAML field"),
    ("npmrc-auth",
     re.compile(r"(?im)^[ \t]*_(?:authToken|password)[ \t]*=[ \t]*\S+"),
     "npmrc auth value"),
    ("netrc-password",
     re.compile(r"(?im)^[ \t]*(?:machine\s+\S+\s+)?login\s+\S+\s+password\s+(?=\S*\d)\S+"),
     "netrc credentials line"),
    ("home-path",
     re.compile(r"/(?:Users|home)/[A-Za-z0-9_.\-]+"),
     "Absolute user-home path"),
]

FILENAME_RULES = [
    # (rule_id, predicate(basename), description)
    ("env-file", lambda b: b == ".env" or b.startswith(".env."), "dot-env style file present"),
    ("netrc-file", lambda b: b == ".netrc", "netrc credential file present"),
    ("git-credentials-file", lambda b: b == ".git-credentials", "git credentials file present"),
    ("ssh-private-key-file",
     lambda b: b in ("id_rsa", "id_dsa", "id_ecdsa", "id_ed25519") or b.endswith(".pem") or b.endswith(".key"),
     "private key file present"),
    ("service-account-file",
     lambda b: "service-account" in b and b.endswith(".json"),
     "service account credential file present"),
    ("credentials-json-file",
     lambda b: b.endswith(".json") and "credential" in b,
     "credential json file present"),
    ("htpasswd-file", lambda b: b == ".htpasswd", "htpasswd file present"),
    ("bare-credentials-file", lambda b: b == "credentials", "credentials file present (review)"),
]

ALL_RULE_IDS = set(r[0] for r in RULES) | set(r[0] for r in FILENAME_RULES)


def utcnow_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + \
        "%03dZ" % (datetime.now(timezone.utc).microsecond // 1000)


def mask(matched_text):
    head = matched_text[:4]
    return "%s...[REDACTED len=%d]" % (head, len(matched_text))


def display_path(path):
    rp = os.path.relpath(path, D1_ROOT)
    if rp.startswith(".."):
        rp = "<outside-workspace>/" + os.path.basename(path)
    return rp


def iter_files(roots):
    for root in roots:
        if os.path.isfile(root):
            yield root
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
            for fn in sorted(filenames):
                if fn in SKIP_FILES:
                    continue
                yield os.path.join(dirpath, fn)


def scan(roots):
    findings = []
    stats = {"filesScanned": 0, "filesSkippedBinary": 0, "filesSkippedLarge": 0, "filesUnreadable": 0}
    for path in iter_files(roots):
        base = os.path.basename(path)
        if os.path.getsize(path) > MAX_FILE_BYTES:
            stats["filesSkippedLarge"] += 1
            continue
        try:
            with open(path, "rb") as fh:
                head = fh.read(BINARY_SNIFF_BYTES)
            if b"\x00" in head:
                stats["filesSkippedBinary"] += 1
                continue
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            stats["filesUnreadable"] += 1
            continue

        stats["filesScanned"] += 1
        dpath = display_path(path)

        for rule_id, pred, desc in FILENAME_RULES:
            if pred(base):
                findings.append({
                    "ruleId": rule_id, "path": dpath, "line": 0,
                    "excerptMasked": "(filename rule) " + base, "description": desc,
                })

        for lineno, line in enumerate(lines, start=1):
            for rule_id, rx, desc in RULES:
                for m in rx.finditer(line):
                    findings.append({
                        "ruleId": rule_id, "path": dpath, "line": lineno,
                        "excerptMasked": mask(m.group(0)), "description": desc,
                    })
    findings.sort(key=lambda f: (f["path"], f["line"], f["ruleId"]))
    return findings, stats


def build_report(roots, findings, stats, started_at, ended_at):
    return {
        "scanner": "check-secrets",
        "scannerVersion": SCANNER_VERSION,
        "startedAt": started_at,
        "endedAt": ended_at,
        "scannedRoots": [display_path(r) for r in roots],
        "skippedDirs": sorted(SKIP_DIRS),
        "ruleCount": len(ALL_RULE_IDS),
        "stats": stats,
        "findingCount": len(findings),
        "findings": findings,
    }


_SYNTH_ALPHABET = "abcdef0123456789"


def _synth(n, offset=0):
    return "".join(_SYNTH_ALPHABET[(i + offset) % len(_SYNTH_ALPHABET)] for i in range(n))


def selftest():
    """Build a synthetic corpus in a temp dir, scan it, assert every rule fires
    and the clean corpus stays clean. No token literals appear in this file."""
    corpus = tempfile.mkdtemp(prefix="treeai-d1-sectest.")
    ok = True
    try:
        clean_dir = os.path.join(corpus, "clean")
        os.makedirs(clean_dir)

        tok40 = _synth(40)
        tok48 = _synth(48, offset=3)
        tok30 = _synth(30, offset=7)
        tok32 = _synth(32, offset=11)
        jwt_tok = ("ey" + "JhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9") + "." + \
                  ("ey" + "JzdWIiOiIxMjM0NTY3ODkwIn0") + "." + \
                  "SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"

        positives = [
            "anthropic style key: " + "sk-ant-" + tok40,
            "openai style key: " + "sk-" + tok48,
            "aws key: " + "AKIA" + "0123456789ABCDEF" + " region eu-west-1",
            "google key: " + "AIza" + _synth(36, offset=2),
            "github token: " + "ghp_" + _synth(40, offset=5),
            "slack token: " + "xoxb-" + "1234-" + "5678-" + "abcd" + "5678",
            "key block:",
            "-----BEGIN " + "OPENSSH PRIVATE KEY" + "-----",
            "jwt: " + jwt_tok,
            "auth header " + "Authorization" + ": " + "Bearer " + tok32,
            "standalone " + "bearer " + _synth(40, offset=13),
            "MY_" + "API_KEY=" + tok30,
            "machine " + "example.test" + " login " + "demo" + " password " + _synth(16, offset=4),
        ]
        pos_path = os.path.join(corpus, "positives.txt")
        with open(pos_path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(positives) + "\n")

        json_key = "api" + "_key"
        json_line = json.dumps({json_key: tok32})
        with open(os.path.join(corpus, "config.json"), "w", encoding="utf-8") as fh:
            fh.write("{\n  " + json_line + "\n}\n")

        env_dir = os.path.join(corpus, "dotenv")
        os.makedirs(env_dir)
        with open(os.path.join(env_dir, ".env"), "w", encoding="utf-8") as fh:
            fh.write("ANTHROPIC_" + "API_KEY=" + "sk-ant-" + tok40 + "\n")
        auth_line = "_" + "authToken" + "=" + tok32
        with open(os.path.join(env_dir, ".npmrc"), "w", encoding="utf-8") as fh:
            fh.write("registry=https://registry.npmjs.org/\n" + auth_line + "\n")
        with open(os.path.join(env_dir, "id_rsa"), "w", encoding="utf-8") as fh:
            fh.write("-----BEGIN " + "RSA PRIVATE KEY" + "-----\n")
        with open(os.path.join(env_dir, "service-account" + "-fake.json"), "w", encoding="utf-8") as fh:
            fh.write("{}\n")
        with open(os.path.join(env_dir, ".netrc"), "w", encoding="utf-8") as fh:
            fh.write("machine example.test login demo password " + _synth(16, offset=4) + "\n")
        with open(os.path.join(env_dir, ".git-credentials"), "w", encoding="utf-8") as fh:
            fh.write("https://demo@example.test\n")
        with open(os.path.join(env_dir, "my-credentials" + "-sample.json"), "w", encoding="utf-8") as fh:
            fh.write("{}\n")
        with open(os.path.join(env_dir, ".htpasswd"), "w", encoding="utf-8") as fh:
            fh.write("demo:$apr1$sample\n")
        with open(os.path.join(env_dir, "credentials"), "w", encoding="utf-8") as fh:
            fh.write("review me\n")

        with open(os.path.join(clean_dir, "notes.txt"), "w", encoding="utf-8") as fh:
            fh.write("The token bucket was empty after the burst.\n")
            fh.write("header was Authorization: Bearer <redacted>\n")
            fh.write("see the contract in the schemas dir\n")
            fh.write("count of values and their sum are checked\n")
            fh.write("/usr/local/bin/node and /opt/homebrew/bin/python3\n")
            fh.write("password policies are documented in the guide\n")

        with open(os.path.join(corpus, "homepaths.txt"), "w", encoding="utf-8") as fh:
            fh.write("src at " + "/Users/" + "fixtureuser" + "/project/main.ts\n")
            fh.write("venv at " + "/home/" + "fixtureuser" + "/repo/.venv\n")

        findings, stats = scan([corpus])

        fired = set(f["ruleId"] for f in findings)
        missing = sorted(ALL_RULE_IDS - fired)
        clean_findings = [f for f in findings if f["path"].startswith("clean/")]
        report_text = json.dumps(findings, ensure_ascii=False)

        leaks = []
        for tok in (tok40, tok48, tok30, tok32, jwt_tok):
            if tok in report_text:
                leaks.append(tok[:6])

        problems = []
        if missing:
            problems.append("rules did not fire: %s" % ", ".join(missing))
        if clean_findings:
            problems.append("false positives on clean corpus: %r" % clean_findings)
        if leaks:
            problems.append("unmasked token fragments in report: %r" % leaks)
        expected_min = len(ALL_RULE_IDS)
        if len(fired) < expected_min:
            problems.append("only %d/%d rules fired" % (len(fired), expected_min))

        if problems:
            ok = False
            print("SELFTEST: FAIL")
            for p in problems:
                print("  - %s" % p)
        else:
            print("SELFTEST: PASS (%d rules fired, %d findings, clean corpus clean, report masked)"
                  % (len(fired), len(findings)))
    finally:
        shutil.rmtree(corpus, ignore_errors=True)
    return ok


def main(argv):
    ap = argparse.ArgumentParser(add_help=True, description="TreeAI D1 secret and redaction scanner")
    ap.add_argument("paths", nargs="*", help="files or directories to scan (default: d1-spikes root)")
    ap.add_argument("--json", metavar="OUT", help="write a machine-readable report to OUT")
    ap.add_argument("--selftest", action="store_true", help="run the synthetic-corpus self-test")
    args = ap.parse_args(argv)

    if args.selftest:
        return 0 if selftest() else 1

    roots = args.paths or [D1_ROOT]
    roots = [os.path.abspath(r) for r in roots]
    for r in roots:
        if not os.path.exists(r):
            sys.stderr.write("check-secrets: no such path: %s\n" % r)
            return 2

    started = utcnow_iso()
    findings, stats = scan(roots)
    ended = utcnow_iso()
    report = build_report(roots, findings, stats, started, ended)

    if findings:
        print("check-secrets: %d finding(s)" % len(findings))
        for f in findings:
            print("  [%s] %s:%d %s" % (f["ruleId"], f["path"], f["line"], f["excerptMasked"]))
    else:
        print("check-secrets: no findings (%d files scanned)" % stats["filesScanned"])

    if args.json:
        with open(args.json, "w", encoding="utf-8") as fh:
            json.dump(report, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        print("report written: %s" % args.json)

    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
