    },
    {
      "id": "inv-06",
      "category": "combining-split",
      "input": {
        "fixture": "md-07",
        "start": 225,
        "end": 231
      },
      "expectReason": "start=225 落在分解形式 café（e + U+0301）的基字符与组合尖音符之间，拆散了字素簇。"
    },
    {
      "id": "inv-07",
      "category": "emoji-split",
      "input": {
        "fixture": "md-06",
        "start": 835,
        "end": 841
      },
      "expectReason": "start=835 落在 👨‍💻（ZWJ 序列）内部：码元边界合法但字素簇被拆开。"
    },
    {
      "id": "inv-08",
      "category": "cross-page",
