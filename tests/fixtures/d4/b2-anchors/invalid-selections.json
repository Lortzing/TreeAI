      "input": {
        "fixture": "md-10",
        "start": -1,
        "end": 50
      },
      "expectReason": "start 为负：canonicalText 偏移从 0 起算，-1 越界。"
    },
    {
      "id": "inv-02",
      "category": "out-of-bounds",
      "input": {
        "fixture": "md-02",
        "start": 3433,
        "end": 3444
      },
      "expectReason": "end 超出 canonicalText 长度（3443）。"
    },
    {
      "id": "inv-03",
      "category": "zero-length",
      "input": {
        "fixture": "md-01",
        "start": 120,
        "end": 120
      },
      "expectReason": "start === end：零长度选区没有可摘录的内容。"
    },
    {
      "id": "inv-04",
      "category": "reversed",
      "input": {
        "fixture": "md-03",
        "start": 400,
        "end": 350
      },
      "expectReason": "end < start：区间方向颠倒。"
    },
    {
      "id": "inv-05",
